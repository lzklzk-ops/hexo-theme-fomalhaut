//- script.
script.
  // 加载层只服务于首帧，不应等待字体、统计或第三方 CDN。
  var preloader = {
    endLoading: function () {
      document.body.style.overflow = 'auto';
      var box = document.getElementById('loading-box');
      if (box) box.classList.add('loaded');
    },
    initLoading: function () {
      document.body.style.overflow = '';
      var box = document.getElementById('loading-box');
      if (box) box.classList.remove('loaded');
    }
  };
  // DOM 已经开始渲染就解除遮罩，网络异常时最多再等 2.5 秒。
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', preloader.endLoading, { once: true });
  } else {
    preloader.endLoading();
  }
  setTimeout(preloader.endLoading, 2500);
  var loadingBox = document.getElementById('loading-box');
  if (loadingBox) loadingBox.addEventListener('click', preloader.endLoading);
