- var pjaxExclude = 'a:not([target="_blank"])'
if theme.pjax.exclude
  each val in theme.pjax.exclude
    - pjaxExclude = pjaxExclude + `:not([href="${val}"])`

- let pjaxSelectors = ['head > title','#config-diff','#body-wrap','#rightside-config-hide','#rightside-config-show','#web_bg','.js-pjax', 'body > title', '#app', '#tag-echarts', '#posts-echart', '#categories-echarts']

- let choose = theme.comments.use
if choose
  if theme.Open_Graph_meta && (choose.includes('Livere') || choose.includes('Utterances') || choose.includes('Giscus'))
    - pjaxSelectors.unshift('meta[property="og:image"]', 'meta[property="og:title"]', 'meta[property="og:url"]')
  if choose.includes('Utterances') || choose.includes('Giscus')
    - pjaxSelectors.unshift('link[rel="canonical"]')

script(src=url_for(theme.asset.pjax))
script.
  let pjaxSelectors = !{JSON.stringify(pjaxSelectors)}

  var pjax = new Pjax({
    elements: '!{pjaxExclude}',
    selectors: pjaxSelectors,
    cacheBust: false,
    analytics: !{theme.google_analytics ? true : false},
    scrollRestoration: false
  })

  function setPersistentMusicMode(compact) {
    const player = window.__persistentMusicPlayer
    if (!player) return

    let closeButton = document.getElementById('persistent-music-close')
    if (!compact) {
      player.classList.remove('aplayer-narrow')
      player.removeAttribute('style')
      if (closeButton) closeButton.remove()
      return
    }

    player.classList.add('aplayer-narrow')
    Object.assign(player.style, {
      position: 'fixed', bottom: '16px', right: '16px', width: '66px',
      margin: '0', zIndex: '1000'
    })

    if (closeButton) return
    closeButton = document.createElement('button')
    closeButton.id = 'persistent-music-close'
    closeButton.type = 'button'
    closeButton.textContent = '×'
    closeButton.title = '关闭音乐播放器'
    closeButton.setAttribute('aria-label', '关闭音乐播放器')
    Object.assign(closeButton.style, {
      position: 'fixed', right: '12px', bottom: '72px', width: '26px', height: '26px',
      border: '0', borderRadius: '50%', background: '#222', color: '#fff',
      fontSize: '20px', lineHeight: '24px', cursor: 'pointer', zIndex: '1001'
    })
    closeButton.addEventListener('click', function () {
      const instance = (window.aplayers || []).find(ap => ap && ap.options && ap.options.container === player)
      if (instance) instance.destroy()
      player.remove()
      window.__persistentMusicPlayer = null
      closeButton.remove()
    })
    document.body.appendChild(closeButton)
  }

  document.addEventListener('pjax:send', function () {

    // removeEventListener scroll 
    ;['tocScrollFn', 'scrollCollect'].forEach(name => {
      const handler = window[name]
      if (!handler) return
      window.removeEventListener('scroll', handler)
      if (typeof handler.cancel === 'function') handler.cancel()
      window[name] = null
    })

    typeof preloader === 'object' && preloader.initLoading()
    document.getElementById('rightside').style.cssText = "opacity: ''; transform: ''"
    
    let persistentPlayer = window.__persistentMusicPlayer || document.querySelector('#aplayer-tao-playlist[data-persist-pjax="true"]')
    const persistentInstance = persistentPlayer && (window.aplayers || []).find(ap => ap && ap.options && ap.options.container === persistentPlayer)
    if (!persistentInstance) persistentPlayer = null
    else window.__persistentMusicPlayer = persistentPlayer

    if (window.aplayers) {
      for (let i = 0; i < window.aplayers.length; i++) {
        const container = window.aplayers[i].options && window.aplayers[i].options.container
        if (container !== persistentPlayer && !window.aplayers[i].options.fixed) {
          window.aplayers[i].destroy()
        }
      }
    }

    if (persistentPlayer) {
      document.body.appendChild(persistentPlayer)
      setPersistentMusicMode(true)
    }

    typeof typed === 'object' && typed.destroy()

    //reset readmode
    const $bodyClassList = document.body.classList
    $bodyClassList.contains('read-mode') && $bodyClassList.remove('read-mode')

    typeof disqusjs === 'object' && disqusjs.destroy()
  })

  document.addEventListener('pjax:complete', function () {
    window.refreshFn()

    document.querySelectorAll('script[data-pjax]').forEach(item => {
      const newScript = document.createElement('script')
      const content = item.text || item.textContent || item.innerHTML || ""
      Array.from(item.attributes).forEach(attr => newScript.setAttribute(attr.name, attr.value))
      newScript.appendChild(document.createTextNode(content))
      item.parentNode.replaceChild(newScript, item)
    })

    GLOBAL_CONFIG.islazyload && window.lazyLoadInstance.update()

    typeof chatBtnFn === 'function' && chatBtnFn()
    typeof panguInit === 'function' && panguInit()

    // google analytics
    typeof gtag === 'function' && gtag('config', '!{theme.google_analytics}', {'page_path': window.location.pathname});

    // baidu analytics
    typeof _hmt === 'object' && _hmt.push(['_trackPageview',window.location.pathname]);

    const persistentPlayer = window.__persistentMusicPlayer
    if (persistentPlayer) {
      const pageMarker = Array.from(document.querySelectorAll('#aplayer-tao-playlist[data-persist-pjax="true"]'))
        .find(player => player !== persistentPlayer)
      if (pageMarker) {
        pageMarker.replaceWith(persistentPlayer)
        setPersistentMusicMode(false)
      } else {
        setPersistentMusicMode(true)
      }
    } else {
      typeof loadMeting === 'function' && document.getElementsByClassName('aplayer').length && loadMeting()
    }

    // prismjs
    typeof Prism === 'object' && Prism.highlightAll()

    typeof preloader === 'object' && preloader.endLoading()
  })

  document.addEventListener('pjax:error', (e) => {
    if (e.request.status === 404) {
      pjax.loadUrl('/404.html')
    }
  })
